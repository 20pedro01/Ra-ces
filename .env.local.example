# Configuración de Supabase
# Obtén estas credenciales en: https://supabase.com/dashboard/project/_/settings/api

NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-aqui

# Opcional (solo servidor para bypass de RLS si es necesario)
# SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-aqui

# Configuración del Servidor de Correo (Resend API)
# Obtén tu API key gratuita en: https://resend.com
RESEND_API_KEY=re_tu_api_key_aqui
EMAIL_FROM="Viva Raíces <onboarding@resend.dev>"

